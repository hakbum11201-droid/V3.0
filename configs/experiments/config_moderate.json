{
  "app": {
    "name": "coinB PRO",
    "version": "3.0.1",
    "default_mode": "paper",
    "exchange": "upbit",
    "market_type": "KRW"
  },
  "markets": [
    "KRW-BTC",
    "KRW-XRP",
    "KRW-SOL"
  ],
  "paths": {
    "logs_dir": "logs",
    "runtime_dir": "runtime",
    "reports_dir": "reports",
    "trades_log": "logs/trades.jsonl",
    "decisions_log": "logs/decisions.jsonl",
    "state": "runtime/state.json",
    "performance_report": "reports/performance_summary.json",
    "tuner_report": "reports/tuner_summary.json",
    "candidate_config": "reports/config_candidate.json"
  },
  "portfolio": {
    "starting_cash_krw": 1000000,
    "max_position_krw": 100000,
    "position_size_pct": 10.0,
    "max_open_positions": 2
  },
  "risk": {
    "min_order_krw": 5000,
    "fee_rate": 0.0005,
    "slippage_pct": 0.05,
    "daily_loss_limit_pct": 3.0,
    "total_loss_limit_pct": 8.0,
    "max_consecutive_losses": 3
  },
  "strategy": {
    "ema_fast_period": 8,
    "ema_slow_period": 21,
    "rsi_period": 14,
    "rsi_max": 78.0,
    "atr_period": 14,
    "atr_min_pct": 0.1,
    "volume_period": 12,
    "volume_ratio_min": 1.05,
    "breakout_period": 12,
    "min_score": 3.0,
    "take_profit_pct": 1.4,
    "stop_loss_pct": 0.8,
    "trailing_stop_pct": 0.7,
    "max_holding_bars": 48,
    "max_holding_seconds": 300,
    "weak_continuation_score": 25.0
  },
  "regime": {
    "enabled": true,
    "btc_market": "KRW-BTC",
    "btc_ema_fast_period": 12,
    "btc_ema_slow_period": 36,
    "btc_change_lookback": 12,
    "btc_min_change_pct": -2.0
  },
  "loss_filter": {
    "enabled": true,
    "lookback_trades": 20,
    "min_recent_trades": 5,
    "max_consecutive_losses": 3,
    "min_recent_win_rate": 0.25,
    "min_expectancy_pct": -0.2
  },
  "microstructure": {
    "enabled": true,
    "ofi_score_min": 50,
    "buy_sell_imbalance_min": 2.2,
    "sweep_score_min": 70,
    "absorption_score_min": 65,
    "continuation_score_min": 65,
    "bid_ask_depth_ratio_min": 1.05,
    "max_spread_pct": 0.12,
    "min_trade_value_3s": 1500000
  },
  "execution": {
    "paper_fill_model": "orderbook_depth_v1",
    "buy_price_source": "best_ask",
    "sell_price_source": "best_bid",
    "max_depth_take_ratio": 0.1,
    "min_liquidity_multiple": 3.0,
    "extra_slippage_pct": 0.03,
    "allow_forced_exit_on_low_liquidity": true
  },
  "live": {
    "enabled": false,
    "mode": "disabled",
    "tiny_live_max_order_krw": 10000
