root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.json]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.txt]
end_of_line = lf

[*.csv]
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf
