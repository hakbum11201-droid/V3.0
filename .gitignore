# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.vs/
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Runtime outputs (Entire folders for safety)
logs/
reports/
runtime/
data/

# Keep folder placeholders (If needed)
!logs/.gitkeep
!reports/.gitkeep
!runtime/.gitkeep
!data/.gitkeep

# Local secrets / keys
.env
.env.*
*.key
*.pem
secrets/
config/secrets.json
secrets.json
credentials.json

# EXCEPTIONS for example files (MUST be after .env.*)
!.env.example
!.env.account.example
!.env.live.example

# Temporary files
*.tmp
*.bak
*.log

# Source folders should stay tracked
!src/
!config/
!docs/
!tests/
